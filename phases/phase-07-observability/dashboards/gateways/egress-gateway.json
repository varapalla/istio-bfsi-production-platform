  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Egress Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_workload_namespace=\"payments\"}[5m]))",
          "legendFormat": "{{destination_workload}}"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "Egress 5xx Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{source_workload_namespace=\"payments\",response_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "Egress P95 Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{source_workload_namespace=\"payments\"}[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "External Destinations",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (destination_service) (rate(istio_requests_total{source_workload_namespace=\"payments\"}[5m]))",
          "legendFormat": "{{destination_service}}"
        }
      ]
    }
  ],
