{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "title": "Request Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(istio_requests_total{destination_service_name=~\"$service\"}[5m]))",
          "legendFormat": "Requests/sec"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "title": "5xx Error Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "100 * sum(rate(istio_requests_total{destination_service_name=~\"$service\",response_code=~\"5..\"}[5m])) / clamp_min(sum(rate(istio_requests_total{destination_service_name=~\"$service\"}[5m])),1)",
          "legendFormat": "5xx %"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "title": "P95 Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(istio_request_duration_milliseconds_bucket{destination_service_name=~\"$service\"}[5m])))",
          "legendFormat": "P95"
        }
      ]
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "title": "Requests by Source Workload",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (source_workload) (rate(istio_requests_total{destination_service_name=~\"$service\"}[5m]))",
          "legendFormat": "{{source_workload}}"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(istio_requests_total,destination_service_name)",
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "title": "BFSI - Istio Service Overview",
  "uid": "bfsi-istio-service",
  "version": 1
}